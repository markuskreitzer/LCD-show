/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2835";

	fragment@0 {
		target = <&spi0>;

		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			panel@0 {
				compatible = "lcdwiki,mhs3528", "panel-mipi-dbi-spi";
				reg = <0>;
				spi-max-frequency = <32000000>;
				format = "b6x2g6x2r6x2";
				reset-gpios = <&gpio 25 1>;
				dc-gpios = <&gpio 24 0>;
				write-only;
				width-mm = <73>;
				height-mm = <49>;

				panel-timing {
					hactive = <480>;
					vactive = <320>;
					hback-porch = <0>;
					vback-porch = <0>;
					clock-frequency = <0>;
					hfront-porch = <0>;
					hsync-len = <0>;
					vfront-porch = <0>;
					vsync-len = <0>;
				};
			};

			touchscreen@1 {
				compatible = "ti,ads7846";
				reg = <1>;
				pinctrl-names = "default";
				pinctrl-0 = <&mhs3528_touch_pins>;
				spi-max-frequency = <2000000>;
				interrupt-parent = <&gpio>;
				interrupts = <17 2>;
				pendown-gpio = <&gpio 17 1>;
				ti,x-min = /bits/ 16 <227>;
				ti,x-max = /bits/ 16 <3936>;
				ti,y-min = /bits/ 16 <268>;
				ti,y-max = /bits/ 16 <3880>;
				ti,pressure-max = /bits/ 16 <255>;
				ti,x-plate-ohms = /bits/ 16 <60>;
				touchscreen-swapped-x-y;
				touchscreen-inverted-x;
			};
		};
	};

	fragment@1 {
		target = <&spidev0>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@2 {
		target = <&spidev1>;

		__overlay__ {
			status = "disabled";
		};
	};

	fragment@3 {
		target = <&gpio>;

		__overlay__ {
			mhs3528_touch_pins: mhs3528_touch_pins {
				brcm,pins = <17>;
				brcm,function = <0>;
				brcm,pull = <2>;
			};
		};
	};
};
